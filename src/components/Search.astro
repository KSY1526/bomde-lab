---
// 머리말 검색(사용자 결정 2026-10-25). 돋보기 → 검색 창. 2026-11-03 사용자: 홈 선수 검색과 하나로 합침 → 창 안은 통합 검색(PlayerSearch posts inline).
// 선수 후보(최대 6명) 아래 글 결과. 엔터 = 첫 선수 후보로, 선수 후보가 없으면 검색 결과 페이지 /search/?q=. 찾기·글 결과 줄은 src/lib/search.ts.
// 홈은 맨 위에 같은 통합 검색창이 있으므로 머리말 버튼을 숨긴다(hideButton, 화면에 검색창 하나).
// mode(2026-11-03 사용자: 구역별 검색 분리) — Base가 구역으로 정한다. 선수 검색 구역 = 선수만, 칼럼 구역 = 글만, 그 밖 = 통합.
//   페이지 안에 같은 구역 검색창이 이미 있으면(선수 검색 첫 화면·선수 페이지·칼럼 첫 화면) Base가 hideButton으로 숨긴다.
// 결과 아래 "크봇에게 이 질문하기"를 누르면 입력한 문장을 크봇(ChatPanel) 입력 칸에 채운다: window에 'kbot:ask' 이벤트 { detail: 질문 }.
// 결과 썸네일은 글 목록과 같은 Thumb(search.json에 HTML로). 그 CSS가 모든 페이지에 실리도록 아래 <template>에 하나 그려 둔다
// 화면 이벤트(logs/<날짜>/event.jsonl): search_open(창 열기). 검색어·클릭 로그(psearch·psearch_click·search·search_click)는 PlayerSearch·lib/search.ts
import Thumb from './Thumb.astro';
import PlayerSearch from './PlayerSearch.astro';
import { SEARCH_PLACEHOLDER, type SearchMode } from '../lib/site';
interface Props { hideButton?: boolean; mode?: SearchMode }
const { hideButton = false, mode = 'all' } = Astro.props;
const dialogLabel = { all: '선수·글 검색', players: '선수 검색', posts: '글 검색' }[mode];
---
<button class:list={['search-btn', { 'is-hidden': hideButton }]} type="button" data-search-open aria-haspopup="dialog">
  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <span class="short">검색</span><span class="long">{SEARCH_PLACEHOLDER[mode]}</span>
</button>

<dialog class="search" data-search aria-label={dialogLabel}>
  <button class="close" type="button" aria-label="검색 닫기" data-search-close>✕</button>
  <div class="search-body">
    <PlayerSearch mode={mode} inline qid="search-q" />
    <button class="to-kbot" type="button" data-search-kbot hidden>크봇에게 이 질문하기</button>
  </div>
</dialog>
<template><Thumb data={{ stat: { value: '', label: '' } } as never} bare /></template>

<script>
  import { ev, askKbot } from '../lib/search';
  const dlg = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dlg.querySelector<HTMLInputElement>('input[type="search"]')!;
  const toKbot = dlg.querySelector<HTMLButtonElement>('[data-search-kbot]')!;

  input.addEventListener('input', () => { toKbot.hidden = !input.value.trim(); });
  document.querySelector('[data-search-open]')!.addEventListener('click', () => {
    dlg.showModal();
    input.focus();
    ev('search_open');
  });
  dlg.querySelector('[data-search-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // 바깥 누르면 닫기

  toKbot.addEventListener('click', () => {
    const q = input.value.trim();
    if (!q) return;
    dlg.close();
    askKbot(q);
  });
</script>

<style>
  .search-btn {
    flex: none; display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 13px; color: var(--muted);
    background: none; border: 1px solid var(--line); border-radius: var(--radius); padding: 3px 10px; cursor: pointer;
  }
  .search-btn svg { width: 14px; height: 14px; }
  .search-btn:hover { color: var(--text); border-color: var(--muted); }
  .search-btn .long { display: none; }
  /* PC: 입력 칸처럼 가로로 길게 (사용자 결정 2026-10-25) */
  @media (min-width: 720px) {
    .search-btn { width: 300px; gap: 8px; padding: 8px 12px; font-size: 14px; background: var(--surface); }
    .search-btn .short { display: none; }
    .search-btn .long { display: inline; }
  }

  .search-btn.is-hidden { display: none; }

  .search {
    width: min(640px, calc(100vw - 24px)); max-height: min(80vh, 720px); margin: 8vh auto auto; padding: 0;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--text);
  }
  .search[open] { display: flex; flex-direction: column; }
  .search::backdrop { background: rgb(0 0 0 / 40%); }
  .search-body { overflow-y: auto; padding: 12px 14px; }
  .search-body :global(.psearch) { max-width: none; }
  .search-body :global(input) { width: calc(100% - 40px); }
  .search-body :global(input::-webkit-search-cancel-button) { display: none; } /* 닫기 ✕와 겹침 */
  .search .search-body :global(.psearch .drop) { margin-top: 12px; border-top: 2px solid var(--head-line); }
  .close { position: absolute; top: 14px; right: 8px; background: none; border: 0; color: var(--muted); font-size: 18px; cursor: pointer; padding: 4px 8px; }

  .to-kbot {
    margin: 12px 0 2px; font: inherit; font-weight: 600; font-size: 14px; padding: 7px 14px;
    border: 1px solid var(--accent); border-radius: var(--radius); background: none; color: var(--accent); cursor: pointer;
  }
  .to-kbot:hover { background: var(--accent); color: var(--bg); }
  @media (max-width: 1023px) {
    .search { margin-top: 12px; max-height: calc(100dvh - 24px); }
  }
</style>

<!-- 결과 줄은 스크립트가 그리므로 전역. 검색 결과 페이지(pages/search.astro)도 같은 class를 쓴다 -->
<style is:global>
  .search-results { list-style: none; margin: 0; padding: 0 14px; overflow-y: auto; }
  .search-results li { border-bottom: 1px solid var(--line); }
  .search-results a { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; padding: 12px 0; color: var(--text); }
  .search-results a.plain { grid-template-columns: minmax(0, 1fr); }
  .search-results .thumb { align-self: start; }
  .search-results .text { display: grid; gap: 3px; align-content: start; min-width: 0; }
  .search-results a:hover { text-decoration: none; }
  .search-results a:hover strong { color: var(--accent); }
  .search-results .meta { font-size: 12.5px; color: var(--accent); }
  .search-results strong { font-size: 16px; line-height: 1.45; word-break: keep-all; }
  .search-results .snip { font-size: 13.5px; color: var(--muted); line-height: 1.55; word-break: keep-all; overflow-wrap: anywhere; }
</style>
