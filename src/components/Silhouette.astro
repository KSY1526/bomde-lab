---
import { silhouette } from '../lib/silhouette';

interface Props { pitcher?: boolean; height?: number; weight?: number; flip?: boolean; no?: string; c?: string }
const { pitcher = false, height = 183, weight = 92, flip = false, no = '', c = '#000' } = Astro.props;
---
<Fragment set:html={silhouette({ pitcher, height, weight, flip, no, numColor: c, fill: '#fff' })} />

<style>
  :global(.sil) { display: block; width: 100%; height: 100%; overflow: visible; }
</style>
