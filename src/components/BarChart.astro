---
// 가로 막대 차트(순위·비교용). 빌드 때 SVG로 그려 JS 없이 보인다.
// ref: 기준선(예: wRC+ 100 = 리그 평균). min을 주면 막대가 그 값에서 시작한다(차이를 잘 보이게).
interface Row { label: string; value: number; highlight?: boolean; note?: string }
interface Props {
  rows: Row[];
  title: string;
  caption?: string;
  unit?: string;
  digits?: number;
  min?: number;
  ref?: { value: number; label: string };
}
const { rows, title, caption, unit = '', digits = 1, min = 0, ref } = Astro.props;

const W = 640, labelW = 92, valueW = 60, rowH = 30, padTop = ref ? 22 : 8;
const plotL = labelW, plotR = W - valueW;
const max = Math.max(...rows.map((r) => r.value), ref?.value ?? -Infinity);
const x = (v: number) => plotL + ((v - min) / (max - min || 1)) * (plotR - plotL);
const H = padTop + rows.length * rowH + 8;
---
<figure class="chart">
  <figcaption class="title">{title}</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {rows.map((r, i) => {
      const y = padTop + i * rowH;
      return (
        <g class={r.highlight ? 'hl' : ''}>
          <text x={labelW - 10} y={y + rowH / 2} class="label" text-anchor="end" dominant-baseline="central">{r.label}</text>
          <rect x={plotL} y={y + 6} width={Math.max(x(r.value) - plotL, 1)} height={rowH - 12} rx="3" class="bar" />
          <text x={x(r.value) + 6} y={y + rowH / 2} class="value" dominant-baseline="central">
            {r.value.toFixed(digits)}{unit}{r.note ? ` ${r.note}` : ''}
          </text>
        </g>
      );
    })}
    {ref && (
      <g>
        <line x1={x(ref.value)} x2={x(ref.value)} y1={padTop - 4} y2={H - 4} class="ref" />
        <text x={x(ref.value)} y={12} class="ref-label" text-anchor="middle">{ref.label}</text>
      </g>
    )}
  </svg>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<style>
  .chart { margin: 1.6em 0; padding: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .title { font-weight: 700; font-size: 15px; margin-bottom: 8px; }
  .cap { color: var(--muted); font-size: 13px; margin-top: 8px; }
  svg { width: 100%; height: auto; display: block; }
  .label { fill: var(--text); font-size: 14px; }
  .value { fill: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
  .bar { fill: var(--pos); opacity: .55; }
  .hl .bar { fill: var(--neg); opacity: 1; }
  .hl .label { font-weight: 800; fill: var(--accent); }
  .hl .value { fill: var(--accent); font-weight: 700; }
  .ref { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .ref-label { fill: var(--muted); font-size: 12px; }
</style>
