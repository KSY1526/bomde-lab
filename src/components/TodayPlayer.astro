---
// 홈 "오늘의 선수"(요청 H, 2026-11-03 사용자: 홈 C안). 배포가 push 때만 일어나서 빌드 때 후보 전원을 그려 두고
// 브라우저가 한국시간 날짜로 한 명만 보이게 한다(같은 날은 누구나 같은 선수). JS가 꺼져 있으면 첫 후보(WAR 1위)가 보인다.
// 후보 = 2026 표본 충족 + 등급 S+·S(lib/home.ts). 아래 "비교 바로가기" 한 줄도 후보마다 하나씩 같이 바뀐다.
import type { CollectionEntry } from 'astro:content';
import Hexagon from './Hexagon.astro';
import { todayCandidates, nameIsAmbiguous, SEASON } from '../lib/home';
import { CATEGORIES, url, formatDate } from '../lib/site';

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
const cands = todayCandidates();
const RELATED = 2;
const items = cands.map((c) => {
  const amb = nameIsAmbiguous(c.name);
  const related = posts.filter((p) => p.data.tags.includes(c.name) && (!amb || p.data.tags.includes(c.team))).slice(0, RELATED);
  return { c, related };
});
---
{items.length > 0 && (
  <section class="today" aria-labelledby="today-h" data-today>
    <div class="sec-head"><h2 id="today-h" class="sec-title">오늘의 선수</h2></div>
    {items.map(({ c, related }, i) => (
      <div class="tp" data-tp={i} hidden={i !== 0}>
        <div class="grid">
          <div class="hx"><Hexagon vals={c.vals} size={300} /></div>
          <div class="info">
            <h3 class="name"><a href={url(`players/${c.id}`)}>{c.name}</a></h3>
            <p class="sub">{c.team} · {c.pos} · {SEASON} 정규시즌</p>
            <p class="grade"><b>{c.grade}</b><span>{c.type}</span></p>
            <p class="rank">{c.kind === 'b' ? '타자' : '투수'} WAR {c.rank}위 <span class="muted">({c.war.toFixed(2)})</span></p>
            {related.length > 0 && (
              <>
                <h4 class="rel-h">관련 칼럼</h4>
                <ul class="rel">
                  {related.map((p) => <li><a href={url(`posts/${p.id}`)}>{p.data.title}</a> <span class="muted">{CATEGORIES[p.data.category]} · {formatDate(p.data.date)}</span></li>)}
                </ul>
              </>
            )}
            <a class="go" href={url(`players/${c.id}`)}><span>{c.name} 전체 기록 보기</span><i aria-hidden="true">›</i></a>
          </div>
        </div>
      </div>
    ))}
  </section>
)}

<script>
  // 한국시간 날짜(UTC+9) 기준 일 번호 % 후보 수
  const root = document.querySelector<HTMLElement>('[data-today]');
  if (root) {
    const all = [...root.querySelectorAll<HTMLElement>('[data-tp]')];
    const day = Math.floor((Date.now() + 9 * 3600e3) / 86400e3);
    const pick = day % all.length;
    all.forEach((el, i) => { el.hidden = i !== pick; });
  }
</script>

<style>
  .today { margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 28px; align-items: center; padding-top: 14px; }
  .hx { max-width: 300px; }
  .name { margin: 0; font-size: 26px; letter-spacing: -.02em; }
  .name a { color: var(--text); }
  .sub { margin: 4px 0 12px; font-size: 14px; color: var(--muted); }
  .grade { display: flex; align-items: baseline; gap: 10px; margin: 0 0 4px; }
  .grade b { font: 700 34px/1 var(--num); color: var(--navy); }
  .grade span { font-size: 17px; font-weight: 700; }
  .rank { margin: 0 0 14px; font-size: 15px; font-variant-numeric: tabular-nums; }
  .rel-h { margin: 0 0 4px; font-size: 14px; }
  .rel { margin: 0 0 10px; padding-left: 18px; font-size: 14.5px; }
  .rel li { margin: 2px 0; }
  .muted { color: var(--muted); font-size: 13px; }
  .go { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 360px; padding: 12px 16px; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line)); border-radius: 6px; background: color-mix(in srgb, var(--accent) 12%, var(--surface)); color: var(--text); font-weight: 600; font-size: 15px; transition: background .15s; }
  .go i { font-style: normal; font-size: 22px; line-height: 1; color: var(--accent); }
  .go:hover { background: color-mix(in srgb, var(--accent) 22%, var(--surface)); text-decoration: none; }
  @media (max-width: 560px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .hx { margin: 0 auto; width: 100%; }
    .name { font-size: 24px; }
  }
</style>
