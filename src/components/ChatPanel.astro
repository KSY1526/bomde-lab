---
// 크봇 챗봇. 두 가지 모양(2026-10-28 사용자 결정: PC 우측 고정 칸은 이용이 적어 없앰)
//   inline = 선수 페이지·선수검색 첫 화면 맨 아래 본문 안. "더 자세한 기록" 질문용, 예시 질문은 페이지가 넘긴다
//   popup(기본) = 다른 페이지. 평소엔 안 보이고 헤더 검색의 "크봇에게 이 질문하기"(kbot:ask)로 창이 뜬다.
//   모바일(1023px 이하)은 둘 다 우하단 버튼 → 아래에서 올라오는 창(inline은 본문 안에 그대로 보임).
// 서버(Tailscale Funnel, 2단계에서 구현) 계약:
//   GET  {API}/health → { ok, remaining_today: number }  (ok:false = 사용 한도가 차서 쉬는 중, 2026-10-24)
//   POST {API}/chat   { question, history: [{ q, a }] } → { reply, posts?, remaining_today } | 4xx/5xx { error, remaining_today? }
//   history = 30분 안의 직전 문답 최대 2개(추가 질문 맥락)
//   posts = 답과 관련된 발행 글 최대 2편 [{ id, title, category, date }] → 답 아래 글 링크로 보인다(2026-10-25)
// 닉네임은 받지 않는다(사용자 결정 2026-10-25, 질문 문턱 낮추기).
// 헤더 검색(Search.astro)·검색 결과 페이지의 "크봇에게 이 질문하기"는 window 'kbot:ask' 이벤트로 질문을 넘긴다 → 창을 열고 입력 칸에 채운다.
// 보내기는 사용자가 누른다(2026-10-26 사용자 요청: 자동으로 보내지 말 것)
// 문답은 비공개(사용자 결정 2026-10-10) — 각자 브라우저에 자기 문답만 보관한다.
import { url } from '../lib/site';
interface Props {
  inline?: boolean;
  /** 예시 질문(누르면 입력 칸에 채움) */
  examples?: string[];
  /** 첫 안내 말 */
  lead?: string;
}
const {
  inline = false,
  examples = ['롯데 올해 팀 OPS 순위', '김도영 2024 wRC+', '박세웅 구종별 피안타율'],
  lead = 'KBO 기록이라면 무엇이든 물어보세요. 2010년부터의 정규시즌 투구·타석 데이터로 답해 드려요. 관련된 글이 있으면 같이 찾아 드려요.',
} = Astro.props;
const api = (import.meta.env.PUBLIC_KBOT_API ?? '').replace(/\/$/, '');
---
{!inline && (
  <button class="chat-fab" type="button" aria-controls="kbot-panel" aria-expanded="false" data-chat-toggle>
    크봇에게 물어보기
  </button>
)}

<section id="kbot-panel" class:list={['chat', inline ? 'inline' : 'popup']} data-api={api} data-base={url()} aria-labelledby="kbot-title">
  <header class="chat-head">
    <div>
      <h2 id="kbot-title">크봇에게 물어보기</h2>
      <p class="status" data-status><span class="dot"></span><span data-status-text>연결 확인 중…</span></p>
    </div>
    <button class="close" type="button" aria-label="챗봇 닫기" data-chat-toggle>✕</button>
  </header>

  <ol class="log" data-log aria-live="polite">
    <li class="msg bot intro">
      {lead}
      <span class="examples">
        {examples.map((x) => <button type="button" data-example>{x}</button>)}
      </span>
    </li>
  </ol>

  <form class="ask" data-form>
    <label class="sr-only" for="kbot-q">질문</label>
    <textarea id="kbot-q" name="question" maxlength="300" rows="2" placeholder="예) 롯데 불펜 9월 평균자책점" required></textarea>
    <div class="ask-row">
      <span class="muted small" data-count>0/300</span>
      <button type="submit" data-submit>보내기</button>
    </div>
  </form>
  <p class="foot muted small">하루 질문 수에 제한이 있어요.</p>
</section>

<script>
  type PostRef = { id: string; title: string; category: string; date: string };
  type Turn = { q: string; a: string; at: number; error?: boolean; posts?: PostRef[] };
  const HISTORY_KEY = 'kbot.history';
  const MAX_HISTORY = 30;
  const CONTEXT_TURNS = 2;
  const CONTEXT_WINDOW_MS = 30 * 60 * 1000;

  // 브라우저 저장소는 막혀 있을 수 있다(사생활 보호 모드 등) → 실패해도 동작
  const store = {
    get(key: string) { try { return localStorage.getItem(key); } catch { return null; } },
    set(key: string, v: string) { try { localStorage.setItem(key, v); } catch { /* 무시 */ } },
  };

  const panel = document.getElementById('kbot-panel')!;
  const api = panel.dataset.api ?? '';
  const log = panel.querySelector<HTMLOListElement>('[data-log]')!;
  const form = panel.querySelector<HTMLFormElement>('[data-form]')!;
  const q = form.querySelector<HTMLTextAreaElement>('textarea')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const count = form.querySelector<HTMLElement>('[data-count]')!;
  const status = panel.querySelector<HTMLElement>('[data-status]')!;
  const statusText = panel.querySelector<HTMLElement>('[data-status-text]')!;
  let online = false;

  function setStatus(state: 'on' | 'off', text: string) {
    status.dataset.state = state;
    statusText.textContent = text;
    online = state === 'on';
    submit.disabled = !online;
  }

  function loadHistory(): Turn[] {
    try { return JSON.parse(store.get(HISTORY_KEY) ?? '[]'); } catch { return []; }
  }
  function saveHistory(h: Turn[]) { store.set(HISTORY_KEY, JSON.stringify(h.slice(-MAX_HISTORY))); }

  function bubble(cls: string, text: string): HTMLLIElement {
    const li = document.createElement('li');
    li.className = `msg ${cls}`;
    li.textContent = text; // 답변은 텍스트로만 넣는다(HTML 주입 방지)
    log.append(li);
    log.scrollTop = log.scrollHeight;
    return li;
  }

  // 답 아래 관련 글 링크(카테고리 · 날짜 + 제목)
  const base = panel.dataset.base ?? '/';
  function addPosts(li: HTMLLIElement, posts?: PostRef[]) {
    if (!posts?.length) return;
    const box = document.createElement('span');
    box.className = 'posts';
    for (const p of posts.slice(0, 2)) {
      const a = document.createElement('a');
      a.href = `${base}posts/${p.id}/`;
      a.addEventListener('click', () => ev('kbot_post_click', p.id));
      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = `${p.category} · ${p.date}`;
      const t = document.createElement('span');
      t.className = 'title';
      t.textContent = p.title;
      a.append(meta, t);
      box.append(a);
    }
    li.append(box);
  }

  for (const t of loadHistory()) {
    bubble('me', t.q);
    addPosts(bubble(t.error ? 'bot error' : 'bot', t.a), t.posts);
  }

  q.addEventListener('input', () => { count.textContent = `${q.value.length}/300`; });
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); }
  });
  panel.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
    b.addEventListener('click', () => {
      q.value = b.textContent ?? ''; q.dispatchEvent(new Event('input')); q.focus();
      ev('kbot_example', b.textContent ?? '');
    }));
  // 화면 이벤트(Visit.astro): 크봇을 열거나 질문 칸을 눌렀을 때 한 번
  function ev(name: string, detail?: string) {
    (window as unknown as { bomdeEvent?: (n: string, d?: string) => void }).bomdeEvent?.(name, detail);
  }
  q.addEventListener('focus', () => ev('kbot_open'));

  async function checkHealth() {
    if (!api) { setStatus('off', '준비 중이에요'); return; }
    try {
      const r = await fetch(`${api}/health`, { signal: AbortSignal.timeout(5000) });
      const j = await r.json();
      if (j.ok === false) { setStatus('off', '지금은 쉬는 중이에요'); return; }
      setStatus('on', typeof j.remaining_today === 'number' ? `온라인 · 오늘 남은 질문 ${j.remaining_today}개` : '온라인');
    } catch {
      setStatus('off', '지금은 쉬는 중이에요');
    }
  }

  function recentContext() {
    const cutoff = Date.now() - CONTEXT_WINDOW_MS;
    return loadHistory().filter((t) => !t.error && t.at >= cutoff).slice(-CONTEXT_TURNS).map(({ q, a }) => ({ q, a }));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = q.value.trim();
    if (!question || !online) return;
    bubble('me', question);
    q.value = ''; count.textContent = '0/300';
    const wait = bubble('bot pending', '크봇이 기록을 찾아보는 중이에요…');
    submit.disabled = true;
    let turn: Turn;
    try {
      const r = await fetch(`${api}/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, history: recentContext() }),
        signal: AbortSignal.timeout(200_000),
      });
      const j = await r.json().catch(() => ({}));
      turn = r.ok
        ? { q: question, a: j.reply, at: Date.now(), posts: Array.isArray(j.posts) ? j.posts : undefined }
        : { q: question, a: j.error ?? '지금은 답변을 만들지 못했어요. 잠시 후 다시 물어봐 주세요.', at: Date.now(), error: true };
      if (typeof j.remaining_today === 'number') setStatus('on', `온라인 · 오늘 남은 질문 ${j.remaining_today}개`);
    } catch {
      turn = { q: question, a: '크봇과 연결이 끊겼어요. 잠시 후 다시 물어봐 주세요.', at: Date.now(), error: true };
      checkHealth();
    }
    wait.className = turn.error ? 'msg bot error' : 'msg bot';
    wait.textContent = turn.a;
    addPosts(wait, turn.posts);
    log.scrollTop = log.scrollHeight;
    saveHistory([...loadHistory(), turn]);
    submit.disabled = !online;
  });

  // popup: 버튼(모바일)·검색 넘김으로 열고 닫기. inline은 늘 본문 안에 있다
  const fab = document.querySelector<HTMLButtonElement>('.chat-fab');
  const inline = panel.classList.contains('inline');
  function setOpen(open: boolean) {
    panel.classList.toggle('open', open);
    fab?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('chat-open', open);
    if (open) { q.focus(); ev('kbot_open'); }
  }
  document.querySelectorAll('[data-chat-toggle]').forEach((b) =>
    b.addEventListener('click', () => setOpen(!panel.classList.contains('open'))));

  // 헤더 검색에서 넘어온 질문: 창을 열고(모바일) 질문을 넣어 바로 보낸다. 크봇이 쉬는 중이면 넣어 두기만
  window.addEventListener('kbot:ask', (e) => {
    const text = String((e as CustomEvent).detail ?? '').slice(0, 300);
    if (!text) return;
    if (inline) panel.scrollIntoView({ block: 'center' });
    else setOpen(true);
    q.value = text; q.dispatchEvent(new Event('input')); q.focus();
  });

  checkHealth();
</script>

<style>
  .chat { display: flex; flex-direction: column; overflow: hidden; }
  .chat-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
    padding: 12px 0 10px; border-top: 2px solid var(--head-line); border-bottom: 1px solid var(--line);
  }
  .chat-head h2 { margin: 0; font-size: 17px; }
  .status { margin: 2px 0 0; font-size: 12.5px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .status[data-state='on'] .dot { background: var(--ok); }
  .status[data-state='off'] .dot { background: var(--accent); }
  .close { display: none; background: none; border: 0; color: var(--muted); font-size: 18px; cursor: pointer; padding: 4px 8px; }

  .log { list-style: none; margin: 0; padding: 14px 0; flex: 1; max-height: calc(100vh - 380px); overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
  /* 말풍선은 JS로 만들어져 Astro 범위 스타일이 붙지 않는다 → :global로 지정(.log 안으로 한정) */
  .log :global(.msg) {
    max-width: 92%; min-width: 0; padding: 10px 13px; border-radius: var(--radius); font-size: 14.5px; line-height: 1.65;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: keep-all;
  }
  .log :global(.msg.bot) { background: var(--surface); border: 1px solid var(--line); align-self: flex-start; max-width: 100%; }
  .log :global(.msg.me) { background: var(--board); color: var(--board-text); align-self: flex-end; }
  .log :global(.msg.pending) { color: var(--muted); }
  .log :global(.msg.error) { background: var(--red-soft); color: var(--accent); }
  .intro { white-space: normal; }
  .log :global(.posts) { display: grid; margin-top: 10px; border-top: 1px solid var(--line); white-space: normal; }
  .log :global(.posts a) { display: grid; gap: 1px; padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--text); }
  .log :global(.posts a:last-child) { border-bottom: 0; padding-bottom: 0; }
  .log :global(.posts a:hover) { text-decoration: none; }
  .log :global(.posts a:hover .title) { color: var(--accent); }
  .log :global(.posts .meta) { font-size: 12px; color: var(--accent); }
  .log :global(.posts .title) { font-weight: 600; font-size: 14px; line-height: 1.5; word-break: keep-all; }
  .examples { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .examples button {
    font: inherit; font-size: 13px; padding: 3px 9px; border-radius: var(--radius); cursor: pointer;
    border: 1px solid var(--line); background: var(--bg); color: var(--text);
  }
  .examples button:hover { border-color: var(--accent); color: var(--accent); }

  .ask { display: grid; gap: 8px; padding: 12px 0; border-top: 1px solid var(--line); }
  .ask input, .ask textarea {
    width: 100%; font: inherit; font-size: 15px; padding: 8px 10px; resize: none;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text);
  }
  .ask input:focus, .ask textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .ask-row { display: flex; justify-content: space-between; align-items: center; }
  .ask button {
    font: inherit; font-weight: 600; padding: 6px 18px; border: 0; border-radius: var(--radius);
    background: var(--accent); color: var(--bg); cursor: pointer;
  }
  .ask button:disabled { background: var(--line); color: var(--muted); cursor: not-allowed; }
  .small { font-size: 12.5px; }
  .foot { margin: 0; padding: 0 0 12px; }

  .chat-fab { display: none; }
  /* inline: 본문 맨 아래 */
  .chat.inline { margin-top: 40px; }
  .chat.inline .log { max-height: 460px; }
  /* popup: 평소 숨김, 열리면 PC는 오른쪽 아래 창 */
  .chat.popup { display: none; }
  @media (min-width: 1024px) {
    .chat.popup.open {
      display: flex; position: fixed; right: 24px; bottom: 24px; width: 380px; height: min(80vh, 640px); z-index: 50;
      background: var(--bg); padding: 0 16px; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 4px 20px rgb(0 0 0 / 16%);
    }
    .chat.popup.open .log { max-height: none; }
    .chat.popup .close { display: block; }
  }
  @media (max-width: 1023px) {
    .chat-fab {
      display: inline-flex; gap: 6px; align-items: center; position: fixed; right: 16px; bottom: 16px; z-index: 40;
      padding: 11px 18px; border: 0; border-radius: var(--radius); background: var(--accent); color: var(--bg);
      font: inherit; font-weight: 600; box-shadow: 0 2px 8px rgb(0 0 0 / 18%); cursor: pointer;
    }
    .chat.popup { display: none; }
    .chat.popup.open {
      display: flex; position: fixed; inset: auto 0 0 0; height: min(80vh, 640px); z-index: 50;
      background: var(--bg); padding: 0 16px; border-top: 1px solid var(--line); box-shadow: 0 -4px 16px rgb(0 0 0 / 12%);
    }
    .chat.popup .close { display: block; }
    .chat.popup.open .log { max-height: none; }
    :global(body.chat-open) .chat-fab { display: none; }
  }
</style>
