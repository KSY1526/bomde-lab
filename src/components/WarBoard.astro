---
// 홈 "2026 WAR 순위"(요청 H, 2026-11-03 사용자: B안 순위표). 2026 표본 충족 타자·투수 각 5명, 일반 표(숫자판 면 칠하지 않음).
// 등급은 글자로 S+·S만(그 아래는 빈칸). 섹션 머리 오른쪽 "전체 순위 보기" = /rankings/(요청 L)
import { qualified, SEASON } from '../lib/home';
import { url } from '../lib/site';

const TOP = 5;
const pools = qualified();
const tables = (['b', 'p'] as const).map((k) => ({ k, title: k === 'b' ? '타자' : '투수', n: pools[k].length, rows: pools[k].slice(0, TOP) }));
---
<section class="war-board" aria-labelledby="war-h">
  <div class="sec-head"><h2 id="war-h" class="sec-title">{SEASON} WAR 순위</h2><a class="more" href={url('rankings')}>전체 순위 보기</a></div>
  <div class="two">
    {tables.map((t) => (
      <div>
        <h3 class="th">{t.title} <span>(표본 충족 {t.n}명)</span></h3>
        <table>
          <colgroup><col class="c-rank" /><col /><col class="c-team" /><col class="c-war" /><col class="c-grade" /></colgroup>
          <thead><tr><th class="c">순위</th><th>선수</th><th>팀</th><th class="n">WAR</th><th class="c">등급</th></tr></thead>
          <tbody>
            {t.rows.map((r) => (
              <tr><td class="c">{r.rank}</td><td><a href={url(`players/${r.id}`)}>{r.name}</a></td><td>{r.team}</td><td class="n">{r.war.toFixed(2)}</td><td class="c g">{r.grade}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </div>
</section>

<style>
  .more { color: var(--muted); white-space: nowrap; font-size: 13.5px; }
  .more:hover { color: var(--accent); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding-top: 12px; }
  .th { margin: 0 0 6px; font-size: 15px; }
  .th span { font-weight: 400; color: var(--muted); font-size: 13.5px; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14.5px; font-variant-numeric: tabular-nums; }
  th { text-align: left; font-weight: 600; font-size: 13px; color: var(--muted); padding: 6px 6px; border-bottom: 1px solid var(--text); }
  td { padding: 7px 6px; border-bottom: 1px solid var(--line); }
  .c-rank { width: 3em; } .c-team { width: 4.5em; } .c-war { width: 4em; } .c-grade { width: 3.5em; }
  td a { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .n { text-align: right; }
  .c { text-align: center; }
  td.n { white-space: nowrap; }
  .g { font-weight: 700; }
  @media (max-width: 560px) {
    .two { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
</style>
