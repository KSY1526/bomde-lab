---
// 글 끝 "이 글 영상으로 보기"(사용자 결정 2026-10-25). 글 frontmatter youtube에 적은 영상을 본문 끝·태그 위에 내장한다.
// 롱폼(가로)이 먼저, 쇼츠(세로)는 그 아래. 화면에 가까워질 때만 불러온다(loading="lazy")
interface Props { videos: { id: string; type: 'long' | 'short' }[] }
const order = { long: 0, short: 1 };
const videos = [...Astro.props.videos].sort((a, b) => order[a.type] - order[b.type]);
---
{videos.length > 0 && (
  <section class="yt" aria-labelledby="yt-title">
    <h2 id="yt-title">이 글 영상으로 보기</h2>
    {videos.map((v) => (
      <div class:list={['frame', v.type]}>
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${v.id}?rel=0`}
          title="유튜브 영상"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    ))}
  </section>
)}

<style>
  .yt { margin-top: 40px; }
  h2 { margin: 0 0 16px; font-size: 1.25em; line-height: 1.4; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .frame { margin: 0 0 20px; background: var(--line); border-radius: var(--radius); overflow: hidden; }
  .frame.long { aspect-ratio: 16 / 9; }
  .frame.short { aspect-ratio: 9 / 16; max-width: 320px; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
