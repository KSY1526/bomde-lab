---
// 글 좋아요(사용자 결정 2026-10-19). 한 사람(IP 해시)당 글마다 하나, 다시 누르면 취소. 서버는 챗봇·댓글과 같은 곳.
//   GET  {API}/likes?post=<slug> → { count, liked }
//   POST {API}/likes { post }    → { count, liked }
// 서버가 꺼져 있으면 버튼을 숨긴다(글은 그대로 보인다)
interface Props { slug: string }
const { slug } = Astro.props;
const api = (import.meta.env.PUBLIC_KBOT_API ?? '').replace(/\/$/, '');
---
<div class="like" data-like data-api={api} data-slug={slug} hidden>
  <button type="button" data-like-btn aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.1 3.6 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.6 0 5.7 3.6 4.5 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
    좋아요 <span class="digits" data-like-count></span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-like]').forEach((box) => {
    const { api, slug } = box.dataset;
    if (!api || !slug) return;
    const btn = box.querySelector<HTMLButtonElement>('[data-like-btn]')!;
    const count = box.querySelector<HTMLElement>('[data-like-count]')!;
    const show = (d: { count?: number; liked?: boolean }) => {
      if (typeof d.count !== 'number') return;
      count.textContent = d.count.toLocaleString('ko-KR');
      btn.setAttribute('aria-pressed', String(!!d.liked));
      box.hidden = false;
    };
    fetch(`${api}/likes?post=${encodeURIComponent(slug)}`, { signal: AbortSignal.timeout(5000) })
      .then((r) => (r.ok ? r.json() : {})).then(show).catch(() => {});
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const r = await fetch(`${api}/likes`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post: slug }), signal: AbortSignal.timeout(5000),
        });
        if (r.ok) show(await r.json());
      } catch { /* 서버가 꺼져 있으면 그대로 */ }
      btn.disabled = false;
    });
  });
</script>

<style>
  .like { margin-top: 32px; }
  button {
    display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: 15px; font-weight: 600;
    padding: 8px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); cursor: pointer;
  }
  button:hover { border-color: var(--accent); }
  button:disabled { opacity: .6; cursor: wait; }
  svg { width: 18px; height: 18px; fill: none; stroke: var(--accent); stroke-width: 2; }
  button[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  button[aria-pressed='true'] svg { fill: var(--accent); }
  .digits { font-size: 18px; }
</style>
