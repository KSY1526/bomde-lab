---
// 선수 검색창. 이름(또는 "이름 팀")을 치면 후보 목록, 동명이인은 팀·포지션·기간으로 구분한다.
// 색인은 /player-index.json(처음 입력할 때 한 번 받음). 후보 줄 등급은 S+·S만(2026-11-03 사용자).
// posts = 통합 검색(2026-11-03 사용자: 머리말 글 검색과 홈 선수 검색을 하나로). 선수 후보(최대 6명) 아래 글 결과(/search.json, src/lib/search.ts).
//   엔터 = 첫 선수 후보로, 선수 후보가 없으면 글 검색 결과 페이지(/search/?q=). 홈 맨 위와 머리말 검색 창(Search.astro)이 쓴다.
//   posts 없이(선수검색 메뉴 첫 화면·선수 페이지 맨 위) = 선수만, 엔터 = 첫 후보.
// mode(2026-11-03 사용자: 구역별 검색 분리) = 'all' 통합(posts와 같음) · 'players' 선수만(기본) · 'posts' 글만(칼럼 구역: 칼럼 첫 화면·머리말 검색 창).
//   글만은 선수 색인을 받지 않고 글 결과 최대 8개, 엔터 = 글 검색 결과 페이지(/search/?q=). 로그는 search만(psearch 없음).
// inline = 결과를 떠 있는 목록이 아니라 검색창 아래 흐름으로(머리말 검색 창 안).
// 로그(Visit.astro): psearch(검색어, 입력 1.5초 멈춤), psearch_click("id 이름"). 통합 검색은 글 검색 로그 search(검색어)·search_click(lib/search.ts)도 같이
import { url, SEARCH_PLACEHOLDER as PLACEHOLDER, type SearchMode } from '../lib/site';
interface Props { autofocus?: boolean; posts?: boolean; mode?: SearchMode; inline?: boolean; qid?: string }
const { autofocus = false, posts = false, inline = false, qid = 'psearch-q' } = Astro.props;
const mode: SearchMode = Astro.props.mode ?? (posts ? 'all' : 'players');
const withPosts = mode !== 'players', withPlayers = mode !== 'posts';
---
<form class:list={['psearch', { inline }]} data-psearch data-index={withPlayers ? `${url()}player-index.json` : undefined} data-posts={withPosts ? `${url()}search.json` : undefined} data-base={url()} role="search">
  <label class="sr-only" for={qid}>{PLACEHOLDER[mode]}</label>
  <input id={qid} type="search" maxlength={withPosts ? 300 : 40} autocomplete="off" placeholder={PLACEHOLDER[mode]} autofocus={autofocus} data-q />
  <div class="drop" data-drop hidden>
    <ol class="cands" data-list></ol>
    {withPosts && <ol class="search-results" data-posts-list aria-live="polite"></ol>}
  </div>
</form>

<script>
  import { load as loadPosts, loaded as postsLoaded, search as searchPosts, renderRows, searchUrl } from '../lib/search';
  type Row = [string, string, 'b' | 'p', string, string, number, number, string[], string];
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-psearch]')) {
    const input = form.querySelector<HTMLInputElement>('[data-q]')!;
    const drop = form.querySelector<HTMLElement>('[data-drop]')!;
    const list = form.querySelector<HTMLOListElement>('[data-list]')!;
    const postList = form.querySelector<HTMLOListElement>('[data-posts-list]');
    const postsSrc = form.dataset.posts;
    const inline = form.classList.contains('inline');
    const base = form.dataset.base ?? '/';
    const playersSrc = form.dataset.index, postsOnly = !playersSrc;
    let rows: Row[] | null = null, loading: Promise<void> | null = null;
    const load = () => Promise.all([
      playersSrc ? (loading ??= fetch(playersSrc).then((r) => r.json()).then((j) => { rows = j; })) : null,
      postsSrc ? loadPosts(postsSrc) : null,
    ]);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let hits: Row[] = [], typing = 0;
    const ev = (n: string, d?: string) => (window as unknown as { bomdeEvent?: (n: string, d?: string) => void }).bomdeEvent?.(n, d);
    const logQ = () => {
      const q = input.value.trim();
      if (!q) return;
      if (!postsOnly) ev('psearch', q.slice(0, 100));
      if (postsSrc) ev('search', q.slice(0, 100));
    };

    function render() {
      const q = input.value.trim();
      const words = q.split(/\s+/).filter(Boolean);
      if (!words.length || (!postsOnly && !rows)) { drop.hidden = true; hits = []; return; }
      // 모든 낱말이 이름이나 뛴 팀에 들어 있어야. 이름이 정확히 같은 선수 먼저, 그다음 최근에 뛴 순(색인 순서)
      hits = postsOnly ? [] : rows!.filter((r) => words.every((w) => r[1].includes(w) || r[7].some((t) => t.toLowerCase() === w.toLowerCase())));
      hits.sort((a, b) => Number(words.includes(b[1])) - Number(words.includes(a[1])));
      hits = hits.slice(0, postsSrc ? 6 : 20);
      const postRows = postList ? searchPosts(q, postsOnly ? 8 : 5) : [];
      if (postList) renderRows(postList, postRows, q, base);
      const none = hits.length === 0 && (!postList || (postsLoaded() && postRows.length === 0));
      list.innerHTML = hits.length
        ? hits.map((r) => `<li><a href="${base}players/${r[0]}/"><b>${esc(r[1])}</b><span>${esc(r[7].join('·'))} · ${esc(r[4])} · ${r[5] === r[6] ? r[5] : `${r[5]}–${r[6]}`}</span>${r[8] ? `<em>${esc(r[8])}</em>` : ''}</a></li>`).join('')
        : none ? `<li class="none">${postsOnly ? '글에서 찾지 못했어요.' : postList ? '선수와 글에서 찾지 못했어요.' : '2010년 이후 1군에서 뛴 선수 중에 없어요.'}</li>` : '';
      list.hidden = list.innerHTML === '';
      if (postList) postList.hidden = postRows.length === 0;
      drop.hidden = false;
    }
    input.addEventListener('focus', () => { load(); });
    input.addEventListener('input', () => { load().then(render); clearTimeout(typing); typing = window.setTimeout(logQ, 1500); });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      clearTimeout(typing);
      if (hits[0]) { logQ(); ev('psearch_click', `${hits[0][0]} ${hits[0][1]}`); location.href = `${base}players/${hits[0][0]}/`; }
      else if (postsSrc && (rows || postsOnly)) { logQ(); location.href = searchUrl(base, q); }
    });
    list.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a'), r = a && hits.find((h) => a.pathname.endsWith(`/players/${h[0]}/`));
      if (r) { logQ(); ev('psearch_click', `${r[0]} ${r[1]}`); }
    });
    if (!inline) document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) drop.hidden = true; });
    input.addEventListener('focus', () => { if (input.value.trim() && (rows || postsOnly)) render(); });
  }
</script>

<style>
  .psearch { position: relative; max-width: 520px; }
  input {
    width: 100%; font: inherit; font-size: 16px; padding: 10px 12px;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text);
  }
  input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .drop {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 4px);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); max-height: min(70vh, 560px); overflow-y: auto;
  }
  .inline .drop { position: static; border: 0; border-radius: 0; max-height: none; overflow: visible; background: none; }
  .cands { margin: 0; padding: 0; list-style: none; }
  .cands :global(li + li) { border-top: 1px solid var(--line); }
  .cands :global(a) { display: flex; gap: 10px; align-items: baseline; padding: 8px 12px; color: var(--text); }
  .cands :global(a:hover), .cands :global(a:focus) { background: var(--chip-bg); text-decoration: none; }
  .cands :global(b) { font-weight: 600; white-space: nowrap; }
  .cands :global(span) { font-size: 13px; color: var(--muted); }
  .cands :global(em) { margin-left: auto; font-style: normal; font-weight: 700; font-size: 14px; color: var(--text); white-space: nowrap; }
  .cands :global(.none) { padding: 8px 12px; font-size: 14px; color: var(--muted); }
  .drop .search-results { padding: 0 12px; }
  .cands:not([hidden]) + .search-results:not([hidden]) { border-top: 1px solid var(--text); }
  .drop .search-results :global(li:last-child) { border-bottom: 0; }
  .inline .cands :global(a) { padding-left: 0; padding-right: 0; }
  .inline .search-results { padding: 0; }
</style>
