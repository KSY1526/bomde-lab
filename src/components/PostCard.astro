---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, url, formatDate } from '../lib/site';
import Thumb from './Thumb.astro';

// 글 목록 한 줄: 왼쪽 썸네일(구단 색 판 + 실루엣 + 숫자 띠, Thumb) + 카테고리·날짜 + 제목 + 요약.
// 썸네일 숫자는 frontmatter stat의 실제 값만. stat이 없는 글은 썸네일 없이 제목만.
// lead = 홈 맨 위 최신 글 하나: 카테고리·날짜 → 가로로 긴 썸네일 → 제목 (2026-10-25 사용자 결정)
interface Props { post: CollectionEntry<'posts'>; lead?: boolean }
const { post, lead = false } = Astro.props;
const { title, description, date, category, stat } = post.data;
const href = url(`posts/${post.id}`);
const Tag = lead ? 'h2' : 'h3';
---
<article class:list={['post-row', { lead, plain: !stat }]}>
  {stat && <Thumb data={post.data} href={href} lead={lead} />}
  <div class="text">
    <p class="meta-line"><a class="cat" href={url(`category/${category}`)}>{CATEGORIES[category]}</a> · <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    <Tag class="title"><a href={href}>{title}</a></Tag>
    <p class="desc">{description}</p>
  </div>
</article>

<style>
  .post-row { display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .post-row.plain { grid-template-columns: minmax(0, 1fr); }
  .meta-line { margin: 0; }
  .meta-line a:hover { text-decoration: none; }
  .title { margin: 4px 0 4px; font-size: 18px; line-height: 1.45; letter-spacing: -.01em; }
  .title a { color: var(--text); }
  .desc { margin: 0; font-size: 14.5px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .lead { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 6px 0 24px; }
  .lead .text { display: contents; }
  .lead .meta-line { order: 1; margin-bottom: 8px; }
  .lead > :global(.thumb) { order: 2; margin-bottom: 4px; }
  .lead :is(.title, .desc) { order: 3; }
  .lead .title { font-size: clamp(24px, 3.4vw, 30px); line-height: 1.3; margin: 6px 0 8px; letter-spacing: -.02em; }
  .lead .desc { font-size: 16px; -webkit-line-clamp: 3; }

  @media (max-width: 560px) {
    .post-row:not(.lead) { grid-template-columns: 112px minmax(0, 1fr); gap: 14px; padding: 16px 0; }
    .post-row.plain { grid-template-columns: minmax(0, 1fr); }
    .title { font-size: 16.5px; }
    .post-row:not(.lead) .desc { display: none; }
  }
</style>
