---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, url, formatDate } from '../lib/site';

// thumb: 왼쪽에 공유 썸네일(/og/<글>.png)을 작게 — "다음에 읽을 글"에서 쓴다(2026-10-18, 이미지 붙은 추천 링크가 더 눌린다)
interface Props { post: CollectionEntry<'posts'>; thumb?: boolean }
const { post, thumb = false } = Astro.props;
const { title, description, date, category } = post.data;
const href = url(`posts/${post.id}`);
const img = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/${post.id}.png`;
---
<article class:list={['post-card', 'card', { thumb }]}>
  {thumb && <a class="thumb-img" href={href} tabindex="-1" aria-hidden="true"><img src={img} alt="" width="1200" height="630" loading="lazy" decoding="async" /></a>}
  <div class="text">
    <div class="meta">
      <a class="chip red" href={url(`category/${category}`)}>{CATEGORIES[category]}</a>
      <time class="muted" datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">{description}</p>
  </div>
</article>

<style>
  .post-card { padding: 18px 20px; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: 13px; }
  .meta a:hover { text-decoration: none; }
  h3 { margin: 8px 0 4px; font-size: 19px; line-height: 1.45; }
  h3 a { color: var(--text); }
  p { margin: 0; font-size: 15px; }

  .thumb { display: grid; grid-template-columns: 200px 1fr; gap: 16px; align-items: start; }
  .thumb-img img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .thumb p { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 560px) {
    .thumb { grid-template-columns: 150px 1fr; gap: 12px; padding: 14px; }
    .thumb h3 { font-size: 16.5px; margin-top: 6px; }
    .thumb p { display: none; }
  }
</style>
