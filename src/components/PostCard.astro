---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, url, formatDate, imgVersion } from '../lib/site';

// 왼쪽에 대표 숫자 썸네일(/thumb/<글>.png) — 홈·카테고리·다음에 읽을 글 모두 (2026-10-18, 이미지 붙은 링크가 더 눌린다)
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, description, date, category } = post.data;
const href = url(`posts/${post.id}`);
const img = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/thumb/${post.id}.png?v=${imgVersion(post.data.stat)}`;
---
<article class="post-card card">
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true"><img src={img} alt="" width="480" height="360" loading="lazy" decoding="async" /></a>
  <div class="text">
    <div class="meta">
      <a class="chip red" href={url(`category/${category}`)}>{CATEGORIES[category]}</a>
      <time class="muted" datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">{description}</p>
  </div>
</article>

<style>
  .post-card { padding: 16px; display: grid; grid-template-columns: 168px 1fr; gap: 18px; align-items: start; }
  .thumb img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .text { min-width: 0; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: 13px; }
  .meta a:hover { text-decoration: none; }
  h3 { margin: 8px 0 4px; font-size: 19px; line-height: 1.45; }
  h3 a { color: var(--text); }
  p { margin: 0; font-size: 15px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 560px) {
    .post-card { grid-template-columns: 112px 1fr; gap: 12px; padding: 14px; }
    h3 { font-size: 16.5px; margin-top: 6px; }
    p { font-size: 14px; }
  }
</style>
