---
import '../styles/global.css';
import ChatPanel from '../components/ChatPanel.astro';
import Visit from '../components/Visit.astro';
import Search from '../components/Search.astro';
import { SITE, SOCIAL, MENU, SUBMENU, sectionOf, url, type SearchMode } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 공유 썸네일 경로(base 제외). 없으면 og/default.png */
  image?: string;
  /** 글 페이지면 게시일 — og:type article·구조화 데이터(BlogPosting)를 붙인다 */
  published?: Date;
  /** 내용을 크게 고친 날(frontmatter updated) — 구조화 데이터 dateModified */
  updated?: Date;
  tags?: string[];
  /** 경로(홈 › 카테고리 › 글). 구글 검색 결과에 경로로 보이게 BreadcrumbList 구조화 데이터를 붙인다 (2026-10-18) */
  breadcrumbs?: { name: string; path: string }[];
  /** 본문 맨 아래 크봇(선수 페이지 등, 2026-10-28). 없으면 크봇은 헤더 검색에서 부를 때만 뜬다 */
  chat?: { examples: string[]; lead?: string };
}
const { title, description = SITE.description, image = 'og/default.png?v=2', published, updated, tags = [], breadcrumbs = [], chat } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/${image}`, Astro.site).href;
const jsonLd = published && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImage,
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  url: canonical.href,
  inLanguage: 'ko',
  keywords: tags.join(', ') || undefined,
  author: { '@type': 'Organization', name: SITE.title, url: new URL(`${base}/`, Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.title },
};
const crumbLd = breadcrumbs.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).href,
  })),
};
const path = Astro.url.pathname;
// 메뉴(2026-11-03 사용자): 대분류 한 줄 + 구역 페이지에서만 소분류 두 번째 줄. 정의는 lib/site.ts MENU·SUBMENU
const section = sectionOf(path);
const sub = (section && SUBMENU[section]) || [];
// 소분류 현재 위치: 선수 개인 페이지 = 선수 검색, 글 페이지 = 경로(breadcrumbs)에 있는 카테고리
const crumbPaths = breadcrumbs.map((c) => c.path);
const isPlayerPage = /^\/players\/[^/]+\/$/.test(path.slice(url().length - 1)) && !path.startsWith(url('players/compare'));
const subCurrent = (p: string) => {
  const href = url(p);
  if (p === 'players') return path === href || isPlayerPage;
  if (p === 'columns') return path === href;
  return path.startsWith(href) || crumbPaths.includes(href);
};
// 머리말 검색: 구역 모드로. 같은 구역 검색창이 페이지에 이미 있으면 숨김(홈·선수 검색 첫 화면·선수 페이지·칼럼 첫 화면)
const searchMode: SearchMode = section === 'players' ? 'players' : section === 'columns' ? 'posts' : 'all';
const hideSearch = path === url() || path === url('players') || isPlayerPage || path === url('columns');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="3I1VI-u3CaZScRVuPY9iX8UuNMOhKGzhFeUN39JyS7Q" />
    <meta name="naver-site-verification" content="b408612e49662b73ca683abd67a100b837fc9877" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151c28" media="(prefers-color-scheme: dark)" />
    <!-- 다크/밝게 버튼으로 고른 값(브라우저에만 저장)을 그리기 전에 적용해 깜빡임을 막는다 -->
    <script is:inline>try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Sans+KR:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap head-row">
        <a class="brand" href={url()}>
          <svg class="logo" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#fff" stroke="#c4202f" stroke-width="4"/><path d="M15 15c8 8 8 26 0 34M49 15c-8 8-8 26 0 34" fill="none" stroke="#c4202f" stroke-width="3" stroke-dasharray="4 3"/></svg>
          <span>
            <strong>{SITE.title}</strong>
            <small>{SITE.tagline}</small>
          </span>
        </a>
        <Search hideButton={hideSearch} mode={searchMode} />
      </div>
      <nav class="wrap nav" aria-label="주 메뉴">
        {MENU.map((m) => <a href={url(m.path)} aria-current={section === m.key ? 'page' : undefined}>{m.label}</a>)}
      </nav>
      {sub.length > 0 && (
        <nav class="subnav-row" aria-label={`${MENU.find((m) => m.key === section)?.label} 메뉴`}>
          <div class="wrap nav sub">
            {sub.map((n) => <a href={url(n.path)} aria-current={subCurrent(n.path) ? 'page' : undefined}>{n.label}</a>)}
          </div>
        </nav>
      )}
    </header>

    <div class="wrap layout">
      <main id="main">
        <slot />
        {chat && <ChatPanel inline examples={chat.examples} lead={chat.lead} />}
      </main>
      {!chat && <ChatPanel />}
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{SITE.title}</strong> · {SITE.tagline}</p>
        <div class="foot-row">
          <p class="social">
            {SOCIAL.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
          </p>
          <!-- 화면 밝기 버튼: 자주 쓰지 않아 헤더(검색 옆)에서 푸터로 옮김(2026-10-25). 기본은 기기 설정을 따른다 -->
          <button class="theme-btn" type="button" data-theme-btn aria-label="화면 밝기 바꾸기">다크</button>
        </div>
      </div>
    </footer>
    <Visit />
    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-btn]');
        const root = document.documentElement;
        const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const label = () => { btn.textContent = isDark() ? '밝게' : '다크'; };
        label();
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
        btn.addEventListener('click', () => {
          const t = isDark() ? 'light' : 'dark';
          root.dataset.theme = t;
          try { localStorage.setItem('theme', t); } catch {}
          label();
        });
      })();
    </script>
    <!-- Cloudflare Web Analytics (2026-10-18): PC가 꺼져도 방문이 집계되게. 쿠키 없음. DNS only라 자동 설정 대신 스니펫 -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c1392abb8d4541a5830dcc26201e6920"}'></script>
  </body>
</html>

<style>
  .site-header { border-bottom: 2px solid var(--head-line); }
  .head-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 20px; padding-bottom: 4px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .logo { width: 40px; height: 40px; flex: none; }
  .brand strong { display: block; font-size: 23px; letter-spacing: -.02em; line-height: 1.2; }
  .brand small { display: block; font-size: 13px; color: var(--muted); }
  .theme-btn {
    flex: none; font: inherit; font-size: 13px; color: var(--muted); background: none;
    border: 1px solid var(--line); border-radius: var(--radius); padding: 3px 10px; cursor: pointer;
  }
  .theme-btn:hover { color: var(--text); border-color: var(--muted); }
  .nav { display: flex; gap: 20px; overflow-x: auto; padding-top: 8px; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a { color: var(--muted); padding: 8px 0 10px; white-space: nowrap; font-size: 15px; }
  .nav a:hover { color: var(--text); text-decoration: none; }
  .nav a[aria-current='page'] { color: var(--accent); font-weight: 600; box-shadow: inset 0 -2px var(--accent); }
  /* 소분류 줄: 대분류 아래 가는 선으로 나눈 두 번째 줄. 휴대폰은 가로 스크롤 */
  .subnav-row { border-top: 1px solid var(--line); }
  .nav.sub { gap: 18px; padding-top: 2px; }
  .nav.sub a { font-size: 14px; padding: 7px 0 8px; }


  .site-footer { border-top: 1px solid var(--line); padding: 24px 0 40px; font-size: 14px; color: var(--muted); }
  .site-footer strong { color: var(--text); }
  .site-footer p { margin: 0 0 4px; }
  .foot-row { display: flex; align-items: center; gap: 16px; } /* 왼쪽 정렬: 휴대폰 우하단은 크봇 버튼이 가린다 */
  .social { display: flex; gap: 14px; }
  .foot-row .social { margin: 0; }
  .social a { color: var(--muted); }
</style>
