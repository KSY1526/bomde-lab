---
import '../styles/global.css';
import ChatPanel from '../components/ChatPanel.astro';
import Visit from '../components/Visit.astro';
import { SITE, SOCIAL, CATEGORIES, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 공유 썸네일 경로(base 제외). 없으면 og/default.png */
  image?: string;
  /** 글 페이지면 게시일 — og:type article·구조화 데이터(BlogPosting)를 붙인다 */
  published?: Date;
  tags?: string[];
}
const { title, description = SITE.description, image = 'og/default.png', published, tags = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/${image}`, Astro.site).href;
const jsonLd = published && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImage,
  datePublished: published.toISOString(),
  url: canonical.href,
  inLanguage: 'ko',
  keywords: tags.join(', ') || undefined,
  author: { '@type': 'Organization', name: SITE.title, url: new URL(`${base}/`, Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.title },
};
const path = Astro.url.pathname;
const nav = [
  ...Object.entries(CATEGORIES).map(([key, label]) => ({ href: url(`category/${key}`), label })),
  { href: url('about'), label: '소개' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="3I1VI-u3CaZScRVuPY9iX8UuNMOhKGzhFeUN39JyS7Q" />
    <meta name="naver-site-verification" content="b408612e49662b73ca683abd67a100b837fc9877" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#041e42" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap head-row">
        <a class="brand" href={url()}>
          <svg class="logo" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#fff" stroke="#d00f31" stroke-width="4"/><path d="M15 15c8 8 8 26 0 34M49 15c-8 8-8 26 0 34" fill="none" stroke="#d00f31" stroke-width="3" stroke-dasharray="4 3"/></svg>
          <span>
            <strong>{SITE.title}</strong>
            <small>{SITE.tagline}</small>
          </span>
        </a>
      </div>
      <nav class="wrap nav" aria-label="주 메뉴">
        <a href={url()} aria-current={path === url() ? 'page' : undefined}>홈</a>
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="stripe" aria-hidden="true"></div>
    </header>

    <div class="wrap layout">
      <main id="main">
        <slot />
      </main>
      <aside class="chat-aside" aria-label="크봇 챗봇">
        <ChatPanel />
      </aside>
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{SITE.title}</strong> · {SITE.tagline}</p>
        <p class="social">
          {SOCIAL.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </p>
      </div>
    </footer>
    <Visit />
    <!-- Cloudflare Web Analytics (2026-10-18): PC가 꺼져도 방문이 집계되게. 쿠키 없음. DNS only라 자동 설정 대신 스니펫 -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c1392abb8d4541a5830dcc26201e6920"}'></script>
  </body>
</html>

<style>
  .site-header { background: var(--header-bg); color: var(--header-text); }
  .head-row { padding-top: 18px; padding-bottom: 6px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: inherit; }
  .brand:hover { text-decoration: none; }
  .logo { width: 44px; height: 44px; flex: none; }
  .brand strong { display: block; font-size: 22px; letter-spacing: -.02em; line-height: 1.2; }
  .brand small { display: block; font-size: 13px; opacity: .75; }
  .nav { display: flex; gap: 4px; overflow-x: auto; padding-top: 6px; padding-bottom: 0; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a {
    color: rgb(255 255 255 / 78%); padding: 8px 12px 10px; white-space: nowrap; font-size: 15px;
    border-bottom: 3px solid transparent;
  }
  .nav a:hover { color: #fff; text-decoration: none; }
  .nav a[aria-current='page'] { color: #fff; font-weight: 700; border-bottom-color: var(--red); }
  .stripe { height: 4px; background: var(--red); }

  .chat-aside { position: sticky; top: 16px; align-self: start; height: calc(100vh - 32px); }
  @media (max-width: 1023px) {
    .chat-aside { position: static; height: auto; }
  }

  .site-footer { border-top: 1px solid var(--line); padding: 24px 0 40px; font-size: 14px; }
  .site-footer p { margin: 0 0 4px; }
  .social { display: flex; gap: 14px; }
</style>
