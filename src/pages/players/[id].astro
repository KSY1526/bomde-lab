---
// 선수 페이지 /players/<id>/ (설계 docs/블로그/선수검색-설계.md 2·4절, 1차: 상단 + 기록 탭).
// 데이터 src/data/players/<id>.json(scripts/export_players.py). 연도 버튼·연도별 작은 육각형을 누르면 위 육각형·유형·등급이 바뀐다(모두 미리 그려 두고 숨김 전환)
import Base from '../../layouts/Base.astro';
import PlayerSearch from '../../components/PlayerSearch.astro';
import Silhouette from '../../components/Silhouette.astro';
import Hexagon from '../../components/Hexagon.astro';
import { teamColor, darken } from '../../lib/teams';
import { url } from '../../lib/site';
import { renderBatter, renderPitcher } from '../../lib/situ';
import '../../styles/situ.css';
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

type Hex = { q: boolean; n: number | null; vals: [string, number, string][]; type: string; grade: string | null; war: number | null };
type Player = {
  id: string; name: string; kind: 'b' | 'p'; team: string; no: string | null; height: number | null; weight: number | null;
  school: string | null; joined: string | null; years: number[]; missing: number[]; pos: string; hand: string; left: boolean;
  hex: Record<string, Hex>; rows: Record<string, any>[]; total: Record<string, any>;
};

// 선수 JSON은 빌드 때 파일로 하나씩 읽는다(import.meta.glob로 2천여 개를 모듈로 묶으면 느리고 메모리를 많이 씀, 2026-10-28)
export function getStaticPaths() {
  const dir = join(process.cwd(), 'src/data/players');
  // 시험 빌드용: PLAYERS_ONLY=68525,64021 이면 그 선수만
  const only = process.env.PLAYERS_ONLY?.split(',');
  return readdirSync(dir).filter((f) => f.endsWith('.json') && (!only || only.includes(f.slice(0, -5))))
    .map((f) => ({ params: { id: f.slice(0, -5) }, props: { file: join(dir, f) } }));
}
const p: Player = JSON.parse(readFileSync((Astro.props as { file: string }).file, 'utf8'));
const bat = p.kind === 'b';
const CUR = 2026; // 지금 시즌(기록 표 강조·연도 버튼 기본값)
const keys = [...p.years.map(String).filter((y) => p.hex[y]), ...(p.hex.career ? ['career'] : [])];
const first = keys.includes(String(CUR)) ? String(CUR) : keys.filter((k) => k !== 'career').at(-1) ?? 'career';
const col = teamColor(p.team);
const f3 = (x: number | null | undefined) => (x == null ? '-' : Math.abs(x) < 1 ? x.toFixed(3).replace(/^(-?)0/, '$1') : x.toFixed(3));
const f2 = (x: number | null | undefined) => (x == null ? '-' : x.toFixed(2));
const f1 = (x: number | null | undefined, s = '') => (x == null ? '-' : x.toFixed(1) + s);
const span = p.years[0] === p.years.at(-1) ? `${p.years[0]}` : `${p.years[0]}–${p.years.at(-1)}`;
const T = p.total;
// 숫자판: 고른 연도면 그 시즌 기록, "통산"이면 통산(2026-10-27 사용자: 연도를 골랐는데 통산이 나오면 안 됨)
const tilesOf = (k: string): [string, string][] => {
  const r = k === 'career' ? T : p.rows.find((x) => String(x.season) === k)!;
  const first: [string, string] = k === 'career' ? [`${T.seasons}`, '시즌'] : [`${r.g}`, '경기'];
  return bat
    ? [first, [r.pa.toLocaleString(), '타석'], [`${r.hr}`, '홈런'], [f3(r.avg), '타율'], [f3(r.ops), 'OPS'], [f1(r.war), 'WAR']]
    : [first, [r.ip, '이닝'], [`${r.w}`, '승'], [f2(r.era), '평균자책점'], [(r.so ?? 0).toLocaleString(), '탈삼진'], [f1(r.war), 'WAR']];
};
const tiles = tilesOf('career');
const bio = [p.hand, p.height && p.weight ? `${p.height}cm ${p.weight}kg` : '', p.school ?? '', p.joined ? `${p.joined} 입단` : ''].filter(Boolean).join(' · ');
const word = bat ? '타격' : '투구';
const head = (k: string) => (k === 'career' ? `통산 ${word} 육각형` : `${k} ${word} 육각형`);
// 등급(2026-10-28 사용자: 7단계, 기준은 화면에 안 씀). 표본 적음은 데이터(export_players.py)의 판정을 따른다
const grade = (h: Hex) => {
  if (!h.grade || h.grade === '표본 적음' || h.war == null) return h.grade;
  const w = h.war;
  return w >= 6 ? 'S+' : w >= 4 ? 'S' : w >= 3 ? 'A+' : w >= 2 ? 'A' : w >= 1 ? 'B+' : w > 0 ? 'B' : 'C';
};
const missingNote = p.missing.length ? `${p.missing.join('·')}년은 1군 기록 없음.` : '';
// 상황별 탭: 기본 시즌(지금 시즌, 없으면 마지막 시즌)만 미리 그리고, 다른 시즌은 버튼을 누를 때 situ.json을 받아 같은 함수로 그린다
const situPath = join(process.cwd(), 'src/data/players-situ', `${p.id}.json`);
const situ: Record<string, any> = existsSync(situPath) ? JSON.parse(readFileSync(situPath, 'utf8')) : {};
const situYears = Object.keys(situ).sort();
const situFirst = situYears.includes(String(CUR)) ? String(CUR) : situYears.at(-1);
const situHtml = !situFirst ? '<p class="soon">상황별 기록이 없습니다.</p>'
  : bat ? renderBatter(situ[situFirst]) : renderPitcher(situ[situFirst], p.name, p.height ?? 183, situFirst);
// AI 요약(scripts/ai_summary.py, 2026 시즌 일부 선수만). **굵게** → <b>
const aiPath = join(process.cwd(), 'src/data/ai-summary', `${p.id}.json`);
const ai: Record<string, { text: string }> = existsSync(aiPath) ? JSON.parse(readFileSync(aiPath, 'utf8')) : {};
// 상황별 AI 요약(scripts/situ_summary.py, Sonnet, 2026 시즌 일부 선수만). 시즌 버튼을 누르면 그 시즌 것만 보인다
const sumPath = join(process.cwd(), 'src/data/situ-summary', `${p.id}.json`);
const situAi: Record<string, { text: string }> = existsSync(sumPath) ? JSON.parse(readFileSync(sumPath, 'utf8')) : {};
const aiHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const title = `${p.name} 기록 · ${word} 육각형`;
// 맨 아래 크봇: 이 페이지에 없는 기록만 예시로(2026-10-28 사용자. 시즌이 끝나 "최근 N경기"는 뺌)
const ly = p.years.at(-1);
const chat = {
  lead: '더 자세한 기록이 궁금하면 크봇에게 물어보세요. 2010년부터의 정규시즌 투구·타석 데이터로 답해 드려요.',
  examples: bat
    ? [`${p.name} ${ly} 월별 성적`, `${p.name} ${ly} 145km 이상 공 상대 성적`, `${p.name} ${ly} 상대 팀별 성적`, `${p.name} ${ly} 구장별 성적`, `${p.name} ${ly} 가장 많이 상대한 투수 성적`]
    : [`${p.name} ${ly} 월별 성적`, `${p.name} ${ly} 이닝별 피OPS`, ...(p.pos === '선발투수' ? [`${p.name} ${ly} 투구 수 50구 전후 피OPS`] : []), `${p.name} ${ly} 상대 팀별 성적`, `${p.name} ${ly} 가장 많이 상대한 타자 성적`],
};
const desc = `${p.name}(${p.team} ${p.pos}) ${span} KBO 1군 연도별 기록과 ${word} 육각형. 통산 ${tiles.map(([v, l]) => `${l} ${v}`).slice(1).join(', ')}.`;
---
<Base title={title} description={desc} chat={chat} breadcrumbs={[{ name: '홈', path: '/' }, { name: '선수검색', path: '/players/' }, { name: p.name, path: `/players/${p.id}/` }]}>
  <PlayerSearch />
  <section class="player" data-player>
    <div class="top">
      <div class="pcard" style={`--tc:${col.c};--tc2:${col.c2};--tc3:${darken(col.c, 0.55)}`}>
        <div class="pc-top"><span>{p.team}</span>{keys.map((k) => grade(p.hex[k]) && <span class:list={['pc-grade', { thin: p.hex[k].grade === '표본 적음' }]} data-y={k} hidden={k !== first}>{grade(p.hex[k])}</span>)}</div>
        <div class="pc-sil"><Silhouette pitcher={!bat} height={p.height ?? undefined} weight={p.weight ?? undefined} flip={p.left} no={p.no ?? ''} c={col.c} /></div>
        <div class="pc-band"><b>{p.name}</b><span>{p.no ? `#${p.no} · ` : ''}{p.pos}</span></div>
      </div>

      <div class="hexwrap">
        {keys.map((k) => <div class="hexhead" data-y={k} hidden={k !== first}><b>{head(k)}</b></div>)}
        <div class="years" role="group" aria-label="시즌 고르기">
          {keys.map((k) => <button type="button" data-pick={k} aria-pressed={k === first ? 'true' : 'false'} class:list={{ nq: !p.hex[k].q }}>{k === 'career' ? '통산' : k}</button>)}
        </div>
        {keys.map((k) => <div class="hexbig" data-y={k} hidden={k !== first}><Hexagon vals={p.hex[k].vals} size={340} /></div>)}
        <a class="cmplink" data-cmplink href={`${url('players/compare')}?p=${p.id}:${first}`}>다른 선수와 육각형 비교</a>
      </div>

      <div class="side">
        {keys.map((k) => <div class="type" data-y={k} hidden={k !== first}>{p.hex[k].type}</div>)}
        {keys.map((k) => <div class="tiles" data-y={k} hidden={k !== first}><span class="tl">{k === 'career' ? '통산' : `${k} 시즌`}</span>{tilesOf(k).map(([v, l]) => <div class="tile"><b>{v}</b><span>{l}</span></div>)}</div>)}
        {bio && <p class="cap">{bio}</p>}
      </div>
    </div>

    <div class="ai">
      {keys.map((k) => (
        <div data-y={k} hidden={k !== first}>
          {ai[k] ? (
            <>
              <p class="aitext" set:html={aiHtml(ai[k].text)} />
              <p class="who">AI 요약 · {k}년 기록으로 생성</p>
            </>
          ) : <p class="muted">AI 요약은 추후 제공합니다.</p>}
        </div>
      ))}
    </div>

    {p.years.length > 1 && (
      <>
        <h2>연도별 모양 변화</h2>
        <div class="strip">
          {keys.filter((k) => k !== 'career').map((k) => (
            <button type="button" class:list={['mini', { nq: !p.hex[k].q }]} data-pick={k} aria-label={`${k} 육각형 보기`}>
              <Hexagon vals={p.hex[k].vals} size={120} labels={false} ring={false} />
              <span>{k}{p.hex[k].q ? '' : ' · 미달'}</span>
            </button>
          ))}
        </div>
      </>
    )}

    <div class="tabs" role="tablist">
      {['상황별', '시즌별 기록', '관련 글'].map((t, i) => <button type="button" role="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>{t}</button>)}
    </div>
    <div data-panel="0">
      {situYears.length > 1 && (
        <div class="seasonbar" role="group" aria-label="상황별 시즌 고르기"><span>시즌</span>
          {situYears.map((y) => <button type="button" data-season={y} aria-pressed={y === situFirst ? 'true' : 'false'}>{y}</button>)}
        </div>
      )}
      <div class="ai situai">
        {(situYears.length ? situYears : ['']).map((y) => (
          <div data-sy={y} hidden={y !== (situFirst ?? '')}>
            {situAi[y] ? (
              <>
                <p class="aitext" set:html={aiHtml(situAi[y].text)} />
                <p class="who">AI 요약 · {y}년 상황별 기록으로 생성</p>
              </>
            ) : <p class="muted">상황별 AI 요약은 추후 제공합니다.</p>}
          </div>
        ))}
      </div>
      <div class="situ" data-situ data-src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/players/${p.id}/situ.json`} data-kind={p.kind} data-name={p.name} data-height={p.height ?? 183} set:html={situHtml} />
    </div>
    <div data-panel="1" hidden>
      <h2>연도별 · 통산</h2>
      <div class="tw">
        {bat ? (
          <table class="rec">
            <thead><tr><th>시즌</th><th class="t">팀</th><th>경기</th><th>타석</th><th>타수</th><th>안타</th><th>홈런</th><th>타점</th><th>도루</th><th>볼넷</th><th>삼진</th><th>타율</th><th>출루</th><th>장타</th><th>OPS</th><th>wRC+</th><th>WAR</th></tr></thead>
            <tbody>
              {p.rows.map((r) => (
                <tr class:list={{ on: r.season === CUR }}><td>{r.season}</td><td class="t">{r.team}</td><td>{r.g}</td><td>{r.pa}</td><td>{r.ab}</td><td>{r.h}</td><td>{r.hr}</td><td>{r.rbi}</td><td>{r.sb}</td><td>{r.bb}</td><td>{r.so}</td>
                  <td>{f3(r.avg)}</td><td>{f3(r.obp)}</td><td>{f3(r.slg)}</td><td><b>{f3(r.ops)}</b></td><td>{r.wrc ?? '-'}</td><td><b>{f2(r.war)}</b></td></tr>
              ))}
              <tr class="tot"><td>통산</td><td class="t">{T.seasons}시즌</td><td>{T.g}</td><td>{T.pa}</td><td>{T.ab}</td><td>{T.h}</td><td>{T.hr}</td><td>{T.rbi}</td><td>{T.sb}</td><td>{T.bb}</td><td>{T.so}</td>
                <td>{f3(T.avg)}</td><td>{f3(T.obp)}</td><td>{f3(T.slg)}</td><td><b>{f3(T.ops)}</b></td><td></td><td><b>{f2(T.war)}</b></td></tr>
            </tbody>
          </table>
        ) : (
          <table class="rec">
            <thead><tr><th>시즌</th><th class="t">팀</th><th>경기</th><th>선발</th><th>승-패</th><th>세</th><th>홀</th><th>이닝</th><th>ERA</th><th>FIP</th><th>WHIP</th><th>K%</th><th>BB%</th><th>직구</th><th>WAR</th></tr></thead>
            <tbody>
              {p.rows.map((r) => (
                <tr class:list={{ on: r.season === CUR }}><td>{r.season}</td><td class="t">{r.team}</td><td>{r.g}</td><td>{r.gs}</td><td>{r.w}-{r.l}</td><td>{r.sv}</td><td>{r.hld}</td><td>{r.ip}</td>
                  <td><b>{f2(r.era)}</b></td><td>{f2(r.fip)}</td><td>{f2(r.whip)}</td><td>{f1(r.k)}</td><td>{f1(r.bb)}</td><td>{f1(r.velo)}</td><td><b>{f2(r.war)}</b></td></tr>
              ))}
              <tr class="tot"><td>통산</td><td class="t">{T.seasons}시즌</td><td>{T.g}</td><td>{T.gs}</td><td>{T.w}-{T.l}</td><td>{T.sv}</td><td>{T.hld}</td><td>{T.ip}</td>
                <td><b>{f2(T.era)}</b></td><td>{f2(T.fip)}</td><td>{f2(T.whip)}</td><td>{f1(T.k)}</td><td>{f1(T.bb)}</td><td></td><td><b>{f2(T.war)}</b></td></tr>
            </tbody>
          </table>
        )}
      </div>
      {missingNote && <p class="note">{missingNote}</p>}
    </div>
    <div data-panel="2" hidden><p class="soon muted">관련 글은 추후 제공합니다.</p></div>
  </section>
</Base>

<script>
  import { renderBatter, renderPitcher } from '../../lib/situ';
  const root = document.querySelector<HTMLElement>('[data-player]')!;
  // 로그(Visit.astro 화면 이벤트): 탭·연도·상황별 시즌·비교 링크
  const ev = (n: string, d?: string) => (window as unknown as { bomdeEvent?: (n: string, d?: string) => void }).bomdeEvent?.(n, d);
  root.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.pick!;
    ev('player_year', k);
    root.querySelectorAll<HTMLElement>('[data-y]').forEach((el) => { el.hidden = el.dataset.y !== k; });
    root.querySelectorAll<HTMLButtonElement>('.years [data-pick]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.pick === k)));
    const cl = root.querySelector<HTMLAnchorElement>('[data-cmplink]')!;
    cl.href = cl.href.replace(/:[^:]*$/, `:${k}`);
    if (b.classList.contains('mini')) root.querySelector('.hexwrap')!.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));
  // 상황별 시즌 버튼: 처음 누를 때 이 선수의 situ.json을 한 번 받아 둔다
  const box = root.querySelector<HTMLElement>('[data-situ]')!;
  let all: Promise<Record<string, any>> | null = null;
  root.querySelectorAll<HTMLButtonElement>('[data-season]').forEach((b) => b.addEventListener('click', async () => {
    const y = b.dataset.season!;
    ev('player_situ_year', y);
    root.querySelectorAll<HTMLButtonElement>('[data-season]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    root.querySelectorAll<HTMLElement>('[data-sy]').forEach((x) => { x.hidden = x.dataset.sy !== y; });
    all ??= fetch(box.dataset.src!).then((r) => r.json());
    const e = (await all)[y];
    box.innerHTML = !e ? '<p class="soon">이 시즌은 상황별 기록이 없습니다.</p>'
      : box.dataset.kind === 'b' ? renderBatter(e) : renderPitcher(e, box.dataset.name!, Number(box.dataset.height), y);
  }));
  // 구종 표 전체·좌타자·우타자 탭(situ.ts가 tbody를 손별로 그려 둠). 시즌을 바꾸면 innerHTML이 새로 들어오므로 위임
  box.addEventListener('click', (x) => {
    const b = (x.target as HTMLElement).closest<HTMLButtonElement>('[data-side]');
    if (!b) return;
    ev('player_pitch_side', b.dataset.side);
    box.querySelectorAll<HTMLButtonElement>('[data-side]').forEach((y) => y.setAttribute('aria-pressed', String(y === b)));
    box.querySelectorAll<HTMLElement>('[data-side-body]').forEach((y) => { y.hidden = y.dataset.sideBody !== b.dataset.side; });
  });
  root.querySelector('[data-cmplink]')!.addEventListener('click', () => ev('player_compare'));
  root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => t.addEventListener('click', () => {
    ev('player_tab', t.textContent ?? '');
    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => { el.hidden = el.dataset.panel !== t.dataset.tab; });
    history.replaceState(null, '', t.dataset.tab === '1' ? '#record' : location.pathname);
  }));
  // 주소 끝 #record = 시즌별 기록 탭을 연 채로(공유용). 상황별이 기본 탭(2026-10-28 사용자)
  if (location.hash === '#record') root.querySelector<HTMLButtonElement>('[data-tab="1"]')!.click();
</script>

<style>
  .player { margin-top: 24px; padding-top: 20px; border-top: 2px solid var(--head-line); }
  .top { display: grid; grid-template-columns: 180px minmax(0, 1fr) 220px; grid-template-areas: 'card hex side'; gap: 22px; align-items: start; }
  .pcard { grid-area: card; background: var(--tc); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .pc-top { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; color: #fffd; font-size: 13px; font-weight: 600; }
  .pc-grade { border: 1.5px solid #fffa; padding: 1px 8px; border-radius: 3px; font: 700 26px/1.1 var(--num); color: #fff; }
  .pc-grade.thin { font: 600 12px/1.4 var(--font); padding: 1px 6px; }
  .pc-sil { height: 200px; padding: 4px 24px 0; }
  .pc-band { background: var(--tc3); border-top: 3px solid var(--tc2); color: #fff; padding: 8px 12px 10px; }
  .pc-band b { display: block; font-size: 24px; line-height: 1.15; }
  .pc-band span { font-size: 13px; opacity: .85; }

  .hexwrap { grid-area: hex; text-align: center; min-width: 0; }
