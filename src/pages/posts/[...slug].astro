---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { publishedPosts } from '../../lib/posts';
import { CATEGORIES, SITE, url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, tags, dataUntil } = post.data;
---
<Base title={title} description={description}>
  <article class="post">
    <header>
      <a class="chip red" href={url(`category/${category}`)}>{CATEGORIES[category]}</a>
      <h1>{title}</h1>
      <p class="muted lead">{description}</p>
      <p class="muted small"><time datetime={date.toISOString()}>{formatDate(date)}</time> · 데이터 기준 {dataUntil}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="source muted small">
      <p>{SITE.source}. 데이터 기준 {dataUntil}. 자체 계산 지표(*)는 공식 기록과 다를 수 있습니다.</p>
      {tags.length > 0 && <p>{tags.map((t) => <span class="chip">#{t}</span>)}</p>}
    </footer>
  </article>
  <Comments slug={post.id} />
</Base>

<style>
  .post header { margin-bottom: 28px; }
  h1 { margin: 12px 0 8px; font-size: clamp(24px, 4vw, 32px); line-height: 1.35; letter-spacing: -.02em; }
  .lead { font-size: 17px; margin: 0 0 8px; }
  .small { font-size: 13.5px; margin: 0; }
  .source { border-top: 1px solid var(--line); padding-top: 16px; margin-top: 32px; }
  .source p { margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px; }
</style>
