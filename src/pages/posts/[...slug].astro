---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { publishedPosts } from '../../lib/posts';
import { CATEGORIES, url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, category, tags, draft } = post.data;
const crumbs = [
  { name: '홈', path: url() },
  { name: CATEGORIES[category], path: url(`category/${category}`) },
  { name: title, path: url(`posts/${post.id}`) },
];
---
<Base title={title} description={description} image={`og/${post.id}.png`} published={date} updated={updated} tags={tags} breadcrumbs={crumbs}>
  <article class="post">
    <header>
      <nav class="crumbs small" aria-label="현재 위치">
        <a href={url()}>홈</a><span aria-hidden="true">›</span><a href={url(`category/${category}`)}>{CATEGORIES[category]}</a>
        {draft && <span class="chip">초안 (배포 안 됨)</span>}
      </nav>
      <h1>{title}</h1>
      <p class="muted lead">{description}</p>
      <p class="muted small"><time datetime={date.toISOString()}>{formatDate(date)}</time><span hidden data-views data-slug={post.id}></span></p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {tags.length > 0 && (
      <footer class="tags muted small">
        <p>{tags.map((t) => <span class="chip">#{t}</span>)}</p>
      </footer>
    )}
  </article>
  <!-- 댓글을 글 바로 아래, 다음에 읽을 글은 그 뒤 (2026-10-18). docs/블로그/진단-2026-10-18.md -->
  <Comments slug={post.id} />
  <RelatedPosts post={post} />
</Base>

<style>
  .post header { margin-bottom: 28px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .crumbs a:last-of-type { color: var(--accent); font-weight: 600; }
  h1 { margin: 12px 0 8px; font-size: clamp(24px, 4vw, 32px); line-height: 1.35; letter-spacing: -.02em; }
  .lead { font-size: 17px; margin: 0 0 8px; }
  .small { font-size: 13.5px; margin: 0; }
  .tags { border-top: 1px solid var(--line); padding-top: 16px; margin-top: 32px; }
  .tags p { margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px; }
</style>
