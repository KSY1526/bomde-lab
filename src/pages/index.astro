---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../lib/posts';
import { CATEGORIES, url } from '../lib/site';

const PER_CATEGORY = 2;

// 메뉴 순서대로 카테고리마다 최신 글 2개. 글이 없는 카테고리는 첫 글이 올라올 때 나타난다.
const posts = await publishedPosts();
const sections = Object.entries(CATEGORIES)
  .map(([key, label]) => {
    const inCat = posts.filter((p) => p.data.category === key);
    return { key, label, total: inCat.length, latest: inCat.slice(0, PER_CATEGORY) };
  })
  .filter((s) => s.total > 0);
---
<Base>
  {sections.map((s) => (
    <section class="cat" aria-labelledby={`cat-${s.key}`}>
      <div class="sec-head">
        <h2 id={`cat-${s.key}`} class="sec-title"><a href={url(`category/${s.key}`)}>{s.label}</a></h2>
        {s.total > PER_CATEGORY && <a class="more small" href={url(`category/${s.key}`)}>전체 {s.total}편 보기 →</a>}
      </div>
      <div class="posts">
        {s.latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  .cat + .cat { margin-top: 36px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; }
  .sec-title { font-size: 20px; margin: 0; }
  .sec-title a { color: var(--text); }
  .more { color: var(--muted); white-space: nowrap; }
  .more:hover { color: var(--accent); }
  .small { font-size: 13.5px; }
  .posts { display: grid; gap: 14px; }
</style>
