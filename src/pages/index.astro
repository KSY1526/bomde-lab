---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PlayerSearch from '../components/PlayerSearch.astro';
import TodayPlayer from '../components/TodayPlayer.astro';
import WarBoard from '../components/WarBoard.astro';
import { publishedPosts } from '../lib/posts';
import { CATEGORIES, url } from '../lib/site';
import { SEASON } from '../lib/home';
import playerIndex from '../data/player-index.json';
import popular from '../data/popular-players.json';

const RECENT = 5;
const PER_CATEGORY = 2;

// 블록 순서(2026-11-03 사용자: 홈 C안 + B안 순위표): 통합 검색·예시 선수 → 오늘의 선수(+비교 바로가기) → 최근 글(최신 5개)
// → 2026 WAR 순위 → 카테고리별 글. 홈에 나오는 선수는 모두 2026에 뛴 선수만(2026-11-03 사용자).
// 카테고리별 글은 메뉴 순서대로 카테고리마다 최근 글에 없는 글 2개. 남는 글이 없는 카테고리는 제목만 둔다.
const posts = await publishedPosts();
const recent = posts.slice(0, RECENT);
const shown = new Set(recent.map((p) => p.id));
const sections = Object.entries(CATEGORIES)
  .map(([key, label]) => {
    const inCat = posts.filter((p) => p.data.category === key);
    return { key, label, total: inCat.length, latest: inCat.filter((p) => !shown.has(p.id)).slice(0, PER_CATEGORY) };
  })
  .filter((s) => s.total > 0);

// 검색창 아래 "많이 찾은 선수"(2026-11-07 사용자: 예시 선수 3명 대신). 최근 선수 검색 클릭을 서로 다른 방문자 수로 센 목록
// src/data/popular-players.json (scripts/popular_players.py가 로그에서 만든다). 홈에는 지금 시즌에 뛴 선수만 나온다
type IRow = [string, string, string, string, string, number, number, string[]];
const lastSeason = new Map((playerIndex as IRow[]).map((r) => [r[0], r[6]]));
const POPULAR = 5;
const examples = popular.players.filter((x) => lastSeason.get(x.id) === SEASON).slice(0, POPULAR);
---
<Base>
  <div class="home-search">
    <PlayerSearch qid="home-q" />
    {examples.length > 0 && (
      <p class="examples">
        <span class="ex-label">많이 찾은 선수</span>
        {examples.map((e) => <a href={url(`players/${e.id}`)}>{e.name}<small>{e.team}</small></a>)}
      </p>
    )}
  </div>

  <TodayPlayer posts={posts} />

  <section class="cat" aria-labelledby="recent-h">
    <div class="sec-head">
      <h2 id="recent-h" class="sec-title">최근 글</h2>
    </div>
    <div class="posts">
      {recent.map((p, i) => <PostCard post={p} lead={i === 0} />)}
    </div>
  </section>

  <WarBoard />

  {sections.map((s) => (
    <section class="cat" aria-labelledby={`cat-${s.key}`}>
      <div class="sec-head">
        <h2 id={`cat-${s.key}`} class="sec-title"><a href={url(`category/${s.key}`)}>{s.label}</a></h2>
        <a class="more small" href={url(`category/${s.key}`)}>전체 {s.total}편 보기</a>
      </div>
      {s.latest.length > 0 && (
        <div class="posts">
          {s.latest.map((p) => <PostCard post={p} />)}
        </div>
      )}
    </section>
  ))}
</Base>

<style>
  .home-search { margin-bottom: 32px; }
  .home-search :global(.psearch) { max-width: none; }
  .home-search :global(input) { font-size: 17px; padding: 13px 14px; }
  .examples { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin: 10px 0 0; font-size: 14.5px; }
  .ex-label { color: var(--muted); font-size: 13px; }
  .examples a { color: var(--text); white-space: nowrap; }
  .examples a:hover { color: var(--accent); text-decoration: none; }
  .examples small { margin-left: 5px; font-size: 12.5px; color: var(--muted); }
  .cat + .cat, :global(.war-board) + .cat { margin-top: 40px; }
  :global(.war-board) { margin-top: 40px; }
  /* 섹션 머리는 오늘의 선수·WAR 순위 부품도 같이 쓴다 */
  :global(.sec-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 6px; border-bottom: 1px solid var(--text); }
  :global(.sec-title) { font-size: 18px; margin: 0; }
  :global(.sec-title a) { color: var(--text); }
  .more { color: var(--muted); white-space: nowrap; }
  .more:hover { color: var(--accent); }
  .small { font-size: 13.5px; }
  .posts { display: grid; }
</style>
