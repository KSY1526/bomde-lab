---
// 지표 사전 목록 (2026-10-18). 분류별로 지표 이름과 한 줄 정의
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';

const GROUPS = ['타격', '투구', '경기 상황', '공통'] as const;
const terms = (await getCollection('glossary')).sort((a, b) => a.data.order - b.data.order);
const title = '지표 사전';
const desc = '우르크, FIP, WPA처럼 글에 나오는 야구 지표를 한 줄 정의와 계산법으로 정리했습니다';
---
<Base title={title} description={desc} breadcrumbs={[{ name: '홈', path: url() }, { name: title, path: url('glossary') }]}>
  <h1>{title}</h1>
  <p class="muted desc">{desc}</p>
  {GROUPS.map((g) => {
    const list = terms.filter((t) => t.data.group === g);
    return list.length > 0 && (
      <section class="group" aria-labelledby={`g-${g}`}>
        <h2 id={`g-${g}`}>{g}</h2>
        <ul>
          {list.map((t) => (
            <li class="card">
              <a class="term" href={url(`glossary/${t.id}`)}>{t.data.term}{t.data.aka && <span class="aka">{t.data.aka}</span>}</a>
              <p class="muted">{t.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</Base>

<style>
  h1 { font-size: 26px; margin: 0 0 6px; }
  .desc { margin: 0 0 22px; font-size: 15.5px; }
  .group + .group { margin-top: 28px; }
  h2 { font-size: 18px; margin: 0 0 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li { padding: 14px 18px; }
  .term { font-size: 18px; font-weight: 700; color: var(--text); }
  .aka { font-size: 14px; font-weight: 600; color: var(--muted); margin-left: 8px; }
  li p { margin: 4px 0 0; font-size: 15px; }
</style>
