---
import Base from '../layouts/Base.astro';
import { SITE, SOCIAL, CATEGORIES, url } from '../lib/site';
import { publishedPosts } from '../lib/posts';
import playerIndex from '../data/player-index.json';

// 규모 숫자는 빌드 때 색인·글 목록에서 센다(하드코딩 금지). 줄[2] = b 타자 / p 투수
const rows = playerIndex as unknown[][];
const batters = rows.filter((r) => r[2] === 'b').length;
const pitchers = rows.filter((r) => r[2] === 'p').length;
const posts = await publishedPosts();
// 초안의 나열 순서: 경기 분석, 선수 분석, 시즌 분석, 심층 분석, 야구 지표 해설
const catOrder = ['game', 'player', 'season', 'deep', 'metrics'];
const catCounts = catOrder
  .map((k) => ({ label: CATEGORIES[k], n: posts.filter((p) => p.data.category === k).length }))
  .filter((c) => c.n > 0);
const nf = (n: number) => n.toLocaleString('ko-KR');
---
<Base title="소개" description={`${SITE.title} 소개`}>
  <article class="prose">
    <h1>{SITE.title}</h1>
    <p>KBO 선수 기록을 찾아보고 비교하는 사이트입니다. 기록 검색과 함께, 기록을 읽는 칼럼을 올립니다.</p>
    <h2>여기서 할 수 있는 일</h2>
    <ul>
      <li><a href={url('players')}>선수 검색</a>: 2010년 이후 1군 타자 {nf(batters)}명 · 투수 {nf(pitchers)}명</li>
      <li>등급·유형·육각형: 시즌마다 지표 6개를 리그 백분위로 그리고, WAR 기준 7단계 등급(S+~C)과 유형을 붙입니다</li>
      <li>상황별 기록: 구종·카운트·주자·좌우·타구 방향별 기록을 2010년부터 시즌별로</li>
      <li><a href={url('players/compare')}>선수 비교</a>: 최대 3명의 육각형을 겹쳐 보고 주소로 공유합니다</li>
      <li>크봇: 2010년부터의 정규시즌 투구·타석 기록 질문에 답합니다. 하루 질문 수 제한이 있습니다</li>
      <li>칼럼 {posts.length}편: {catCounts.map((c) => `${c.label} ${c.n}편`).join(', ')}</li>
    </ul>
    <h2>데이터</h2>
    <ul>
      <li>KBO 정규시즌 2010년~현재 투구·타석·박스스코어 기록</li>
      <li>블로그에는 가공한 통계와 차트만 올립니다</li>
      <li>*가 붙은 지표는 자체 계산이라 공식 기록과 다를 수 있습니다</li>
    </ul>
    <h2>영상</h2>
    <p>블로그 글을 1분 안쪽 세로 영상으로도 만들어 올립니다.</p>
    <ul>
      {SOCIAL.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} @bomde_lab</a></li>)}
    </ul>
    <h2>오픈채팅방</h2>
    <p>롯데 자이언츠 팬 오픈채팅방에도 크봇이 들어가 있어, 대화 중에 궁금한 기록을 바로 물어볼 수 있습니다.</p>
    <p><a href="https://open.kakao.com/o/gLcLEu5h">오픈채팅방 들어가기</a></p>
  </article>
</Base>
