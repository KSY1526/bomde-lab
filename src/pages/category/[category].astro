---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts } from '../../lib/posts';
import { CATEGORIES, CATEGORY_DESC, url } from '../../lib/site';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = CATEGORIES[category];
const desc = CATEGORY_DESC[category];
const posts = (await publishedPosts()).filter((p) => p.data.category === category);
---
<Base title={label} description={desc ?? `봄데 연구소 ${label} 글 모음`} breadcrumbs={[{ name: '홈', path: url() }, { name: label, path: url(`category/${category}`) }]}>
  <h1>{label}</h1>
  {desc && <p class="muted desc">{desc}</p>}
  {posts.length
    ? <div class="posts">{posts.map((p) => <PostCard post={p} />)}</div>
    : <p class="muted">아직 글이 없어요. 곧 채워집니다.</p>}
</Base>

<style>
  h1 { font-size: 26px; margin: 0 0 16px; }
  h1:has(+ .desc) { margin-bottom: 6px; }
  .desc { margin: 0 0 18px; font-size: 15.5px; }
  .posts { display: grid; border-top: 1px solid var(--text); }
</style>
